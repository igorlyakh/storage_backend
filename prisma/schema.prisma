generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STORE
  WAREHOUSE
  ADMIN
  DRIVER
}

enum PackageType {
  PALLET
  BOX
  PACKAGE
  PIECE
}

enum AdminScope {
  NCG
  ADMINISTRATIVE
  RFID
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  SENT
  COMPLETED
  BACKORDER
  REJECTED
}

enum OrderRecipient {
  WAREHOUSE
  ADMIN
}

enum WarehouseRequestStatus {
  NEW
  APPROVED
  SENT
  COMPLETED
}

enum Language {
  EN
  RU
  HE
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  IN_TRANSIT
  COMPLETED
}

model User {
  id           String   @id @default(uuid(7))
  username     String   @unique
  password     String
  role         Role
  isActive     Boolean  @default(true)
  refreshToken String?
  language     Language @default(EN)

  storeId Int?
  store   Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  adminScopes AdminScope[]

  warehouseRequests WarehouseRequest[] @relation("WarehouseCreator")

  suppliers       Supplier[]
  createdReturns  Return[]           @relation("ReturnCreator")
  approvedReturns Return[]           @relation("ReturnApprover")
  pickedUpReturns Return[]           @relation("ReturnDriver")
  closedReturns   Return[]           @relation("ReturnCloser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Categories {
  id    String @id @default(uuid(7))
  name  String @unique
  order Int    @default(0)

  createdAt DateTime @default(now())

  products Product[]
}

model Brand {
  id   String @id @default(uuid(7))
  name String @unique

  stores   Store[]
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id   Int    @id @default(autoincrement())
  name String @unique

  users   User[]
  orders  Order[]
  returns Return[]

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  createdAt DateTime @default(now())
}

model Product {
  id            String      @id @default(uuid(7))
  article       String      @default("000000-00")
  name          String      @unique
  category      Categories? @relation(fields: [categoryId], references: [id])
  categoryId    String?
  tag           AdminScope
  orderRecipient OrderRecipient @default(WAREHOUSE)
  isEnabled     Boolean     @default(true)
  limitPerOrder Int?
  order         Int         @default(0)
  imageUrl      String?

  packageType     PackageType @default(PIECE)
  itemsPerPackage Int         @default(0)

  substituteId  String?
  substitute    Product?  @relation("ProductSubstitute", fields: [substituteId], references: [id], onDelete: SetNull)
  substituteFor Product[] @relation("ProductSubstitute")

  stocks       WarehouseStock[]
  orderItems   OrderItem[]
  requestItems WarehouseRequestItem[]
  returnItems  ReturnItem[]
  brands       Brand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Warehouse {
  id        String  @id @default(uuid(7))
  name      String  @unique
  isDefault Boolean @default(false)

  stocks         WarehouseStock[]
  sourceRequests WarehouseRequest[] @relation("RequestSourceWarehouse")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WarehouseStock {
  id           String @id @default(uuid(7))
  productId    String
  warehouseId  String
  packageCount Int    @default(0)
  quantity     Int

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
}

model Order {
  id      String @id @default(uuid(7))
  storeId Int
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name    String

  status OrderStatus @default(NEW)

  recipientRole  OrderRecipient @default(WAREHOUSE)
  recipientScope AdminScope?

  items OrderItem[]

  customRequest   String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String @id @default(uuid(7))
  orderId   String
  productId String

  requestedQty Int
  shippedQty   Int?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model WarehouseRequest {
  id       String                 @id @default(uuid(7))
  category AdminScope
  status   WarehouseRequestStatus @default(NEW)

  items WarehouseRequestItem[]

  sourceWarehouseId String?
  sourceWarehouse   Warehouse? @relation("RequestSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)

  createdBy String
  creator   User   @relation("WarehouseCreator", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSettings {
  id Int @id @default(1)

  orderDayFrom    Int    @default(0)
  orderDayTo      Int    @default(4)
  orderCutoffTime String @default("14:30")
  supportEmail    String @default("info@example.com")

  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?
  maintenanceEmail   String  @default("info@example.com")

  updatedAt DateTime @updatedAt
}

model WarehouseRequestItem {
  id        String @id @default(uuid(7))
  requestId String
  productId String
  quantity  Int

  packageType PackageType @default(PIECE)

  request WarehouseRequest @relation(fields: [requestId], references: [id])
  product Product          @relation(fields: [productId], references: [id])
}

model Supplier {
  id            String  @id @default(uuid(7))
  name          String
  contactPerson String?
  email         String?
  notes         String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Return {
  id     String       @id @default(uuid(7))
  status ReturnStatus @default(PENDING)

  storeId Int
  store   Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items   ReturnItem[]

  rejectionReason String?

  createdById String
  creator     User   @relation("ReturnCreator", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("ReturnApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  pickedUpById String?
  pickedUpBy   User?     @relation("ReturnDriver", fields: [pickedUpById], references: [id])
  pickedUpAt   DateTime?

  closedById String?
  closedBy   User?     @relation("ReturnCloser", fields: [closedById], references: [id])
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReturnItem {
  id       String @id @default(uuid(7))
  returnId String
  return   Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  customName String?
  quantity  Int
  photoUrl  String
}
